    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.3.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "concurrently": "^8.2.2",
