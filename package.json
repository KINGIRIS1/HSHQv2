    "buffer": "^6.0.3",
    "cors": "^2.8.6",
    "docx": "^9.6.0",
    "docx-preview": "^0.3.2",
    "docxtemplater": "^3.46.0",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.1.7",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "json-server": "^0.17.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "pizzip": "^3.1.6",
    "postcss": "^8.4.35",
    "qrcode.react": "^4.2.0",
